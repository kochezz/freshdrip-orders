# Copy to .env.local for local development. On Vercel these live under
# Project -> Settings -> Environment Variables. Never commit real values.

# Neon: the ERP database (vilagio-inventory-prod), connecting as the
# restricted portal_app role created by db/migrate.sql. Pooled connection.
DATABASE_URL=postgresql://portal_app:PASSWORD@HOST-pooler.REGION.aws.neon.tech/vilagio_inventory?sslmode=require

# Long random string. Signs customer and staff login cookies. Changing it logs everyone out.
SESSION_SECRET=

# Staff sign in at /staff/login with their own VTL ERP email and password.
# The portal calls the ERP API as that person (sales, approvals, delivery notes).
ERP_API_URL=https://vilagio-erp-api.onrender.com/api

# Public address, no trailing slash. Used for links inside emails.
SITE_URL=https://order.vilag.io

# Resend: same API key and verified vilag.io sender the ERP uses.
RESEND_API_KEY=
EMAIL_FROM=freshDrip Orders <orders@vilag.io>

# Named people who get every new-order and new-customer email (comma-separated).
# Every active ERP user with the "sales" role is added automatically
# (ALERT_ROLES in lib/email.js).
ORDER_ALERT_EMAILS=wphiri@vilag.io,ezulu@vilag.io,kjmulilo@vilag.io
